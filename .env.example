# Focus Configuration
# Copy to .env and modify as needed

# =================== Required ===================

# JWT Secret (MUST change in production!)
# Generate: openssl rand -hex 32
SECRET_KEY=change-me-in-production

# Default admin password
DEFAULT_PASSWORD=focus123

# =================== Deployment ===================

# Frontend URL (for share links and CORS)
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# Allowed hosts (add your domain for production)
# Example: localhost,127.0.0.1,your-domain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# =================== AI ===================

# Provider: openai, openai_compatible
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=your-api-key

# Custom API endpoint (OpenRouter, Azure, etc.)
# AI_BASE_URL=https://openrouter.ai/api/v1

# =================== Optional ===================

# Zotero integration
# ZOTERO_LIBRARY_ID=your-library-id
# ZOTERO_API_KEY=your-api-key

# =================== Database ===================

# Database backend (sqlite or postgresql)
# 数据库类型选择（sqlite 或 postgresql）

# SQLite (default for dev, single file)
# SQLite（开发环境默认，单文件数据库）
# DATABASE_URL=sqlite+aiosqlite:///./data/focus.db

# PostgreSQL (recommended for production)
# PostgreSQL（生产环境推荐）
# DATABASE_URL=postgresql+asyncpg://focus:your-password@postgres:5432/focus

# PostgreSQL Configuration (when DATABASE_URL not explicitly set)
# PostgreSQL 配置（DATABASE_URL 未显式设置时使用）
POSTGRES_DB=focus
POSTGRES_USER=focus
POSTGRES_PASSWORD=focus-change-me-in-production  # ⚠️ 生产环境必须修改！

# For external PostgreSQL (outside Docker):
# 外部 PostgreSQL（Docker 外部）:
# DATABASE_URL=postgresql+asyncpg://user:pass@external-host:5432/dbname
